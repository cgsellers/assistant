ANTHROPIC_API_KEY=
DATABASE_URL=sqlite:///./data/ledgerline.db
# Or Postgres, after `docker compose --profile dev up -d`. As the owner, which
# row-level security does not bind -- fine for running migrations; to work as
# the API and worker do, connect as ledgerline_app (see core/dbroles.py):
# DATABASE_URL=postgresql+psycopg://ledgerline:ledgerline@127.0.0.1:5432/ledgerline
STORAGE_DIR=./data/files
