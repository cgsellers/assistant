# Ledgerline on one origin: the client portal at /, the API under /api, the
# team's panel under /panel. One origin means the session cookie and the CSRF
# header work as they do in development (portal/vite.config.ts) -- no CORS,
# no third-party cookies.
#
# Locally the site is plain http on port 8080, as a user without privileges
# can listen on. Online, set SITE_ADDRESS to the domain --
# ledgerline.example.com -- and Caddy obtains and renews its HTTPS certificate
# on its own (it then needs ports 80 and 443, so the container needs
# CAP_NET_BIND_SERVICE or a published-port mapping to 8080/8443); turn
# SESSION_COOKIE_SECURE back on and set PORTAL_URL to https://that-domain.
{
	admin off
}

{$SITE_ADDRESS::8080} {
	encode zstd gzip

	# The API, under /api with the prefix taken off, as the dev server does.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# The panel is the API's own pages, with their own strict CSP.
	handle /panel* {
		reverse_proxy api:8000
	}

	# The portal: built files, and index.html for every route it handles itself.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# Hashed file names: a new build is a new name, so these can be kept forever.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"

		header {
			# Scripts only from here, no eval: PDF.js tests for eval and falls
			# back without it. Inline styles are allowed because the toast
			# library injects its stylesheet; scripts are what matter.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
			X-Content-Type-Options "nosniff"
			# An invitation link carries its token: never pass a URL on.
			Referrer-Policy "no-referrer"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}
	}
}
